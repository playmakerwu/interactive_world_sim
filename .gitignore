cython_debug/

# wandb logs
/wandb/

# datasets
*.hdf5

# Hydra outputs.
# `outputs/*` instead of `outputs/` so the carve-outs below can re-include
# specific files. (Git can't re-include children of an excluded directory.)
outputs/*
# Carve-out: drift quantification report — small JSON, evidence backing
# env.pusht_wm_env.MAX_HORIZON=50. Regenerated by
# tests/env/test_rollout_drift.py.
!outputs/drift_report.json
.hydra

/slurm_logs/

checkpoints

# Pycharm setting
.idea/
data/*

.vscode/
outputs_attn/
ckpts/
*.out

mpc_logs/
mpc_open_loop_logs/

*.mp4

*.onnx
*.trt

*.png
*.pth
*.npy
*.npz

# Phase-1 / Phase-3-A state-estimator artefacts (committed for reproducibility)
!tests/state_estimator/sanity_outputs/**/*.png
!tests/state_estimator/calibration_outputs/**/*.png
!tests/goal_selection/state_goal_overlay.png
!tests/goal_selection/pair_catalog_viz.png
# Note: !tests/goal_selection/state_goal.pt is set after the `*.pt` rule below.

# MPPI diagnostic artefacts under outputs/mppi/ are force-added via
# `git add -f` in commits — trajectory .mp4 and .pt dumps stay ignored to
# keep the repo small (same convention as outputs/state_probe/labels).
# Bulk-labeling and probe-training summary manifests under outputs/ are tracked
# via `git add -f` in the relevant scripts/commits — the .pt label files stay
# ignored to keep the repo small.

outputs_dp/
*.zip

*.pt

# Re-include state-estimator artefacts committed for reproducibility
# (must come after `*.pt` or they get re-ignored).
!tests/goal_selection/state_goal.pt
!tests/goal_selection/pair_goals/*.pt

lightning_logs/
optuna_studies/

# RL outputs (training artefacts are large / regenerable)
rl/outputs/

# Presentation directory: keep small images + json + md, still drop videos/large binaries
!pre/
!pre/**/*.png
!pre/**/*.json
!pre/**/*.md
!pre/**/*.py
pre/**/*.mp4
pre/**/*.pt
pre/**/*.npz

# Local experiment scratch dirs (not part of canonical pipeline)
outputs_fail/
overnight/
